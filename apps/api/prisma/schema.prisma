// ─── Store / Purchases ────────────────────────────────────────────────────────

enum PurchaseCategory {
  UNIFORM
  BOOKS
  MATERIALS
  OTHER
}

model StoreItem {
  id          String           @id @default(cuid())
  tenantId    String
  name        String
  category    PurchaseCategory @default(OTHER)
  price       Float
  description String?
  imageUrl    String? // product photo for the online store
  stock       Int? // null = unlimited; decremented on paid online checkout
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchases Purchase[]

  @@index([tenantId])
  @@map("store_items")
}

model Purchase {
  id           String           @id @default(cuid())
  tenantId     String
  studentId    String
  storeItemId  String?
  itemName     String
  category     PurchaseCategory @default(OTHER)
  quantity     Int              @default(1)
  amount       Float
  purchasedAt  DateTime         @default(now())
  note         String?
  recordedById String
  // Online-checkout fields. Admin-recorded sales default to PAID (no Razorpay);
  // student/parent online purchases go PENDING → PAID after signature verify.
  paymentStatus     String   @default("PAID") // PENDING | PAID | FAILED
  razorpayOrderId   String?  @unique
  razorpayPaymentId String?
  createdAt    DateTime         @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  storeItem  StoreItem? @relation(fields: [storeItemId], references: [id])
  recordedBy User       @relation("PurchaseRecordedBy", fields: [recordedById], references: [id])

  @@index([tenantId])
  @@index([tenantId, studentId])
  @@map("purchases")
}


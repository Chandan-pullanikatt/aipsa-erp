generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Tenant (School) ────────────────────────────────────────────────────────

model Tenant {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  joinCode  String?      @unique
  type      TenantType   @default(SCHOOL)
  status    TenantStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  profile                 SchoolProfile?
  users                   User[]
  classes                 Class[]
  sections                Section[]
  students                Student[]
  guardians               Guardian[]
  invites                 Invite[]
  attendance              Attendance[]
  leaves                  Leave[]
  feeCategories           FeeCategory[]
  feeStructures           FeeStructure[]
  feePayments             FeePayment[]
  announcements           Announcement[]
  notifications           Notification[]
  subjects                Subject[]
  exams                   Exam[]
  examResults             ExamResult[]
  periods                 Period[]
  timetableConfigs        TimetableConfig[]
  teacherAvailability     TeacherAvailability[]
  homeworks               Homework[]
  lmsMaterials            LmsMaterial[]
  lmsMaterialProgress     LmsMaterialProgress[]
  homeworkSubmissions     HomeworkSubmission[]
  classJoinRequests       ClassJoinRequest[]
  lateFeeWaivers          LateFeeWaiver[]
  studentActivities       StudentActivity[]
  premiumLmsSubscriptions PremiumLmsSubscription[]
  busRoutes               BusRoute[]
  routeStops              RouteStop[]
  hostels                 Hostel[]
  hostelRooms             HostelRoom[]
  hostelAllotments        HostelAllotment[]
  messMenus               MessMenu[]
  gatePasses              GatePass[]
  hostelComplaints        HostelComplaint[]
  storeItems              StoreItem[]
  purchases               Purchase[]
  libraryBooks            LibraryBook[]
  bookIssues              BookIssue[]
  schoolEvents            SchoolEvent[]
  eventMedia              EventMedia[]
  deviceTokens            DeviceToken[]
  notificationPreferences NotificationPreference[]
  ccaAreas                CcaArea[]
  ccaGrades               CcaGrade[]
  progressTerms           ProgressTerm[]
  staffProfiles           StaffProfile[]
  departments             Department[]
  hsLearners              HsLearner[]
  hsEnrollments           HsEnrollment[]
  hsLessonProgress        HsLessonProgress[]
  hsSubscriptions         HsSubscription[]
  programs                Program[]
  registrations           Registration[]
  kpiAreas                KpiArea[]
  dailyReports            DailyReport[]

  @@map("tenants")
}

// A tenant is either a SCHOOL (the multi-tenant ERP, default) or an INDIVIDUAL
// home-schooling family (B2C product). INDIVIDUAL tenants never touch the
// class/section/fee school graph — they use the Hs* models below.
enum TenantType {
  SCHOOL
  INDIVIDUAL
}

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

// ─── School Profile ──────────────────────────────────────────────────────────

model SchoolProfile {
  id                String   @id @default(cuid())
  tenantId          String   @unique
  schoolName        String
  address           String?
  city              String?
  state             String?
  country           String   @default("India")
  phone             String?
  email             String?
  website           String?
  logo              String?
  board             String?
  establishedYear   Int?
  lateFeeAmount     Float    @default(0)
  lateFeeGraceDays  Int      @default(0)
  libraryFinePerDay Float    @default(0)
  premiumLmsPrice   Float?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("school_profiles")
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id                 String   @id @default(cuid())
  tenantId           String?
  email              String   @unique
  password           String
  role               Role
  firstName          String
  lastName           String
  phone              String?
  isActive           Boolean  @default(true)
  emailVerified      Boolean  @default(false)
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant                 Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  passwordResets         PasswordReset[]
  student                Student?
  guardian               Guardian?
  teacherAttendance      Attendance[]            @relation("TeacherAttendance")
  userLeaves             Leave[]                 @relation("UserLeaves")
  collectedPayments      FeePayment[]            @relation("FeeCollector")
  createdAnnouncements   Announcement[]          @relation("AnnouncementCreator")
  notifications          Notification[]          @relation("UserNotifications")
  taughtSubjects         Subject[]               @relation("SubjectTeacher")
  taughtPeriods          Period[]                @relation("PeriodTeacher")
  unavailability         TeacherAvailability[]   @relation("TeacherUnavailability")
  postedHomeworks        Homework[]              @relation("HomeworkTeacher")
  lmsProgress            LmsMaterialProgress[]   @relation("LmsProgress")
  gradedSubmissions      HomeworkSubmission[]    @relation("HomeworkGrader")
  reviewedJoinRequests   ClassJoinRequest[]      @relation("JoinRequestReviewer")
  lateFeeWaivers         LateFeeWaiver[]         @relation("LateFeeWaivedBy")
  inchargeClasses        Class[]                 @relation("ClassIncharge")
  addedActivities        StudentActivity[]       @relation("ActivityAddedBy")
  reviewedGatePasses     GatePass[]              @relation("GatePassReviewer")
  recordedPurchases      Purchase[]              @relation("PurchaseRecordedBy")
  issuedBooks            BookIssue[]             @relation("BookIssuedBy")
  createdEvents          SchoolEvent[]           @relation("EventCreatedBy")
  deviceTokens           DeviceToken[]           @relation("UserDeviceTokens")
  notificationPreference NotificationPreference? @relation("UserNotificationPreference")
  ccaAreas               CcaArea[]               @relation("CcaTeacher")
  publishedProgressTerms ProgressTerm[]          @relation("ProgressPublisher")
  staffProfile           StaffProfile?
  headedDepartments      Department[]            @relation("DepartmentHead")
  programRegistrations   Registration[]          @relation("RegistrationRegistrant")
  assignedRegistrations  Registration[]          @relation("RegistrationTeacher")
  preparedDailyReports   DailyReport[]           @relation("DailyReportPreparedBy")

  @@map("users")
}

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  TEACHER
  STAFF
  STUDENT
  PARENT
  HS_PARENT
}

// ─── Password Reset ──────────────────────────────────────────────────────────

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

// ─── Audit Log ───────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String?
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@map("audit_logs")
}

// ─── SIS: Class ──────────────────────────────────────────────────────────────

model Class {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  joinCode          String? @unique
  inchargeTeacherId String?

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inchargeTeacher User?              @relation("ClassIncharge", fields: [inchargeTeacherId], references: [id], onDelete: SetNull)
  sections        Section[]
  students        Student[]
  attendance      Attendance[]
  feeStructures   FeeStructure[]
  subjects        Subject[]
  exams           Exam[]
  periods         Period[]
  homeworks       Homework[]
  joinRequests    ClassJoinRequest[]
  schoolEvents    SchoolEvent[]
  ccaAreas        CcaArea[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("classes")
}

// ─── SIS: Section ────────────────────────────────────────────────────────────

model Section {
  id        String   @id @default(cuid())
  tenantId  String
  classId   String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class      Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  students   Student[]
  attendance Attendance[]

  @@unique([classId, name])
  @@index([tenantId])
  @@map("sections")
}

// ─── SIS: Student ────────────────────────────────────────────────────────────

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  TRANSFERRED
  GRADUATED
}

enum BoardingType {
  DAY_SCHOLAR
  HOSTELER
}

model Student {
  id                String        @id @default(cuid())
  tenantId          String
  admissionNumber   String
  firstName         String
  lastName          String
  dateOfBirth       DateTime?
  gender            Gender?
  bloodGroup        String?
  address           String?
  city              String?
  state             String?
  phone             String?
  classId           String?
  sectionId         String?
  admissionDate     DateTime      @default(now())
  status            StudentStatus @default(ACTIVE)
  photoUrl          String?
  boardingType      BoardingType  @default(DAY_SCHOLAR)
  needsBus          Boolean       @default(false)
  busRouteId        String?
  boardingPoint     String?
  portalPin         String?
  feeAccessOverride Boolean       @default(false)
  userId            String?       @unique
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  tenant                  Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class                   Class?                   @relation(fields: [classId], references: [id])
  section                 Section?                 @relation(fields: [sectionId], references: [id])
  user                    User?                    @relation(fields: [userId], references: [id])
  guardians               Guardian[]
  attendance              Attendance[]
  leaves                  Leave[]
  feePayments             FeePayment[]
  examResults             ExamResult[]
  homeworkSubmissions     HomeworkSubmission[]
  lateFeeWaivers          LateFeeWaiver[]
  activities              StudentActivity[]
  premiumLmsSubscriptions PremiumLmsSubscription[]
  busRoute                BusRoute?                @relation(fields: [busRouteId], references: [id])
  hostelAllotment         HostelAllotment?
  gatePasses              GatePass[]
  hostelComplaints        HostelComplaint[]
  purchases               Purchase[]
  bookIssues              BookIssue[]
  ccaGrades               CcaGrade[]
  progressTerms           ProgressTerm[]
  registrations           Registration[]

  @@unique([tenantId, admissionNumber])
  @@index([tenantId])
  @@index([tenantId, classId])
  @@map("students")
}

// ─── SIS: Guardian ───────────────────────────────────────────────────────────

enum GuardianRelation {
  FATHER
  MOTHER
  GUARDIAN
  SIBLING
  OTHER
}

model Guardian {
  id         String           @id @default(cuid())
  tenantId   String
  studentId  String
  firstName  String
  lastName   String
  relation   GuardianRelation
  phone      String
  email      String?
  occupation String?
  isPrimary  Boolean          @default(false)
  userId     String?          @unique
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([studentId])
  @@map("guardians")
}

// ─── Invite (Magic Link) ─────────────────────────────────────────────────────

model Invite {
  id        String   @id @default(cuid())
  tenantId  String
  email     String
  role      Role
  firstName String
  lastName  String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("invites")
}

// ─── Attendance ───────────────────────────────────────────────────────────────

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
}

model Attendance {
  id         String           @id @default(cuid())
  tenantId   String
  date       DateTime         @db.Date
  studentId  String?
  userId     String?
  classId    String?
  sectionId  String?
  status     AttendanceStatus @default(PRESENT)
  note       String?
  markedById String
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id])
  user    User?    @relation("TeacherAttendance", fields: [userId], references: [id])
  class   Class?   @relation(fields: [classId], references: [id])
  section Section? @relation(fields: [sectionId], references: [id])

  @@unique([tenantId, date, studentId])
  @@unique([tenantId, date, userId])
  @@index([tenantId, date])
  @@index([tenantId, studentId])
  @@map("attendance")
}

// ─── Leave ────────────────────────────────────────────────────────────────────

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model Leave {
  id         String      @id @default(cuid())
  tenantId   String
  studentId  String?
  userId     String?
  fromDate   DateTime    @db.Date
  toDate     DateTime    @db.Date
  reason     String
  status     LeaveStatus @default(PENDING)
  reviewNote String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id])
  user    User?    @relation("UserLeaves", fields: [userId], references: [id])

  @@index([tenantId])
  @@index([studentId])
  @@map("leaves")
}

// ─── HR / Staff Management ──────────────────────────────────────────────────────

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
}

// Extends a User (role STAFF or TEACHER) with HR/employment details. One-to-one
// with User; the User row owns login/identity, StaffProfile owns the employment
// record. Non-teaching staff (accountants, admin, support) use role STAFF.
model StaffProfile {
  id               String         @id @default(cuid())
  tenantId         String
  userId           String         @unique
  employeeId       String?
  departmentId     String?
  designation      String?
  joiningDate      DateTime?      @db.Date
  employmentType   EmploymentType @default(FULL_TIME)
  emergencyContact String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@unique([tenantId, employeeId])
  @@index([tenantId])
  @@index([departmentId])
  @@map("staff_profiles")
}

model Department {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  headId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  head   User?          @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  staff  StaffProfile[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("departments")
}

// ─── Fee Management ───────────────────────────────────────────────────────────

enum FeeFrequency {
  MONTHLY
  QUARTERLY
  ANNUALLY
  ONE_TIME
}

// Ties a fee category to an opt-in service so the defaulter report only bills
// students who actually use it: TRANSPORT → students on a bus route, HOSTEL →
// hostelers. NONE (default) = applies to the whole class (e.g. tuition).
enum FeeServiceType {
  NONE
  TRANSPORT
  HOSTEL
}

model FeeCategory {
  id          String         @id @default(cuid())
  tenantId    String
  name        String
  description String?
  serviceType FeeServiceType @default(NONE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  structures FeeStructure[]
  payments   FeePayment[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("fee_categories")
}

model FeeStructure {
  id            String       @id @default(cuid())
  tenantId      String
  feeCategoryId String
  classId       String?
  amount        Float
  frequency     FeeFrequency
  dueDate       DateTime?    @db.Date
  academicYear  String
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feeCategory    FeeCategory     @relation(fields: [feeCategoryId], references: [id], onDelete: Cascade)
  class          Class?          @relation(fields: [classId], references: [id])
  lateFeeWaivers LateFeeWaiver[]

  @@index([tenantId, academicYear])
  @@map("fee_structures")
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  ONLINE
}

model FeePayment {
  id              String        @id @default(cuid())
  tenantId        String
  studentId       String
  feeCategoryId   String
  academicYear    String
  amount          Float
  month           String?
  paidAt          DateTime      @default(now())
  method          PaymentMethod @default(CASH)
  referenceNumber String?
  receiptNumber   String        @unique
  collectedById   String
  note            String?
  createdAt       DateTime      @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student     Student     @relation(fields: [studentId], references: [id])
  feeCategory FeeCategory @relation(fields: [feeCategoryId], references: [id])
  collectedBy User        @relation("FeeCollector", fields: [collectedById], references: [id])

  @@index([tenantId, studentId])
  @@index([tenantId, academicYear])
  @@map("fee_payments")
}

// ─── Communication ────────────────────────────────────────────────────────────

enum AnnouncementType {
  ANNOUNCEMENT
  CIRCULAR
  EVENT
  ALERT
}

model Announcement {
  id          String           @id @default(cuid())
  tenantId    String
  title       String
  body        String
  type        AnnouncementType @default(ANNOUNCEMENT)
  targetRoles String[]
  isPinned    Boolean          @default(false)
  publishedAt DateTime         @default(now())
  expiresAt   DateTime?
  createdById String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User   @relation("AnnouncementCreator", fields: [createdById], references: [id])

  @@index([tenantId])
  @@map("announcements")
}

model Notification {
  id          String    @id @default(cuid())
  tenantId    String
  userId      String
  title       String
  body        String
  type        String    @default("INFO")
  referenceId String?
  isRead      Boolean   @default(false)
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([tenantId, userId, isRead])
  @@map("notifications")
}

// ─── Push device tokens (FCM) ──────────────────────────────────────────────────

model DeviceToken {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  token     String   @unique
  platform  String   @default("android") // android | ios | web
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation("UserDeviceTokens", fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@map("device_tokens")
}

// ─── Per-user notification channel preferences ─────────────────────────────────

model NotificationPreference {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String   @unique
  inApp     Boolean  @default(true)
  email     Boolean  @default(true)
  push      Boolean  @default(true)
  sms       Boolean  @default(false)
  whatsapp  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation("UserNotificationPreference", fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("notification_preferences")
}

// ─── Examinations ─────────────────────────────────────────────────────────────

model Subject {
  id             String   @id @default(cuid())
  tenantId       String
  classId        String
  name           String
  code           String?
  periodsPerWeek Int      @default(0)
  teacherId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class        Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher      User?         @relation("SubjectTeacher", fields: [teacherId], references: [id])
  examResults  ExamResult[]
  periods      Period[]
  homeworks    Homework[]
  lmsMaterials LmsMaterial[]

  @@unique([tenantId, classId, name])
  @@index([tenantId, classId])
  @@map("subjects")
}

enum ExamStatus {
  SCHEDULED
  ONGOING
  COMPLETED
}

// Term tag for the main, report-card-eligible exam of each term.
// null = class test / non-reportable assessment (never shown on the progress card).
enum ExamTerm {
  TERM_1
  TERM_2
  ANNUAL
}

model Exam {
  id           String     @id @default(cuid())
  tenantId     String
  name         String
  classId      String
  sectionId    String?
  academicYear String
  term         ExamTerm?
  startDate    DateTime   @db.Date
  endDate      DateTime?  @db.Date
  maxMarks     Float      @default(100)
  passingMarks Float      @default(35)
  status       ExamStatus @default(SCHEDULED)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class   Class        @relation(fields: [classId], references: [id])
  results ExamResult[]

  @@index([tenantId, classId])
  @@index([tenantId, academicYear])
  @@map("exams")
}

model ExamResult {
  id            String   @id @default(cuid())
  tenantId      String
  examId        String
  studentId     String
  subjectId     String
  marksObtained Float?
  grade         String?
  isAbsent      Boolean  @default(false)
  remarks       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  @@unique([examId, studentId, subjectId])
  @@index([tenantId, examId])
  @@index([tenantId, studentId])
  @@map("exam_results")
}

// ─── Holistic Progress Card: CCA / Co-scholastic ─────────────────────────────

// Admin-configured co-scholastic activity area, scoped to a class, with its own
// CCA teacher (per area per class) who grades students in it. Mirrors Subject grain.
model CcaArea {
  id        String   @id @default(cuid())
  tenantId  String
  classId   String
  name      String
  teacherId String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class   Class      @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher User?      @relation("CcaTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  grades  CcaGrade[]

  @@unique([tenantId, classId, name])
  @@index([tenantId, classId])
  @@index([tenantId, teacherId])
  @@map("cca_areas")
}

// A student's 3-point (A/B/C) grade in a CCA area for a given term.
model CcaGrade {
  id        String   @id @default(cuid())
  tenantId  String
  ccaAreaId String
  studentId String
  term      ExamTerm
  grade     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ccaArea CcaArea @relation(fields: [ccaAreaId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([ccaAreaId, studentId, term])
  @@index([tenantId, studentId])
  @@map("cca_grades")
}

// One per student × term: conduct grid, achievements, class-teacher remark, and
// the publish gate. facultySnapshot freezes teacher names at publish time.
model ProgressTerm {
  id              String    @id @default(cuid())
  tenantId        String
  studentId       String
  term            ExamTerm
  academicYear    String
  conduct         Json?
  achievements    String?
  remark          String?
  facultySnapshot Json?
  status          String    @default("DRAFT")
  publishedAt     DateTime?
  publishedById   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student     Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  publishedBy User?   @relation("ProgressPublisher", fields: [publishedById], references: [id], onDelete: SetNull)

  @@unique([studentId, term, academicYear])
  @@index([tenantId, studentId])
  @@map("progress_terms")
}

// ─── Timetable ────────────────────────────────────────────────────────────────

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

model Period {
  id           String    @id @default(cuid())
  tenantId     String
  classId      String
  academicYear String
  dayOfWeek    DayOfWeek
  periodNumber Int
  startTime    String
  endTime      String
  subjectId    String?
  teacherId    String?
  isBreak      Boolean   @default(false)
  breakLabel   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class   Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id])
  teacher User?    @relation("PeriodTeacher", fields: [teacherId], references: [id])

  @@unique([tenantId, classId, academicYear, dayOfWeek, periodNumber])
  @@index([tenantId, classId])
  @@index([tenantId, teacherId])
  @@map("periods")
}

model TimetableConfig {
  id                         String   @id @default(cuid())
  tenantId                   String
  academicYear               String
  workingDays                Json // ["MONDAY", … "SATURDAY"]
  slots                      Json // [{ periodNumber, startTime, endTime, isBreak, breakLabel }]
  maxPeriodsPerDayPerTeacher Int      @default(6)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, academicYear])
  @@index([tenantId])
  @@map("timetable_configs")
}

model TeacherAvailability {
  id           String    @id @default(cuid())
  tenantId     String
  teacherId    String
  academicYear String
  dayOfWeek    DayOfWeek
  periodNumber Int? // null = whole day unavailable
  reason       String?
  createdAt    DateTime  @default(now())

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacher User   @relation("TeacherUnavailability", fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([tenantId, teacherId, academicYear, dayOfWeek, periodNumber], map: "teacher_avail_unique")
  @@index([tenantId, teacherId])
  @@map("teacher_availability")
}

// ─── Homework ─────────────────────────────────────────────────────────────────

model Homework {

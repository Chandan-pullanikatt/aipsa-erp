NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=postgresql://aipsaerp:YOUR_DB_PASSWORD@localhost:5432/aipsaerp

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=7d

# Zepto Mail (SMTP)
SMTP_HOST=smtp.zeptomail.in
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=emailapikey
SMTP_PASS=your_zeptomail_api_key
SMTP_FROM=no-reply@allindiaprivateschools.org

# Frontend URL
WEB_URL=http://localhost:3000

# Super admin seed password
SUPER_ADMIN_PASSWORD=your_secure_admin_password

# File storage — server disk. Files are written here and served back via the API
# at /api/files, reached from the browser through the Next.js proxy.
# In Docker this is a mounted volume (docker-compose sets UPLOAD_DIR=/app/uploads).
UPLOAD_DIR=./uploads
# Public prefix the browser uses to load a stored file. Leave as the proxy path so
# the API needs no public port; override only if serving files from a CDN/origin.
LOCAL_UPLOAD_URL_PREFIX=/api/proxy/files

# ─── Notifications ──────────────────────────────────────────────────────────────
# All optional: any channel whose vars are unset is silently disabled.

# Push — Firebase Cloud Messaging (Project settings → Service accounts → Generate key)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the full key; keep literal \n sequences (the API converts them)
FIREBASE_PRIVATE_KEY=

# SMS + WhatsApp — MSG91 (https://msg91.com). SMS needs TRAI DLT-approved templates;
# WhatsApp needs Meta-approved templates. Map each event to its template id/name.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_WHATSAPP_NUMBER=
MSG91_WA_LANG=en

# SMS DLT template ids (per event)
MSG91_TEMPLATE_ANNOUNCEMENT=
MSG91_TEMPLATE_FEE_DUE=
MSG91_TEMPLATE_FEE_RECEIVED=
MSG91_TEMPLATE_ATTENDANCE_ABSENT=

# WhatsApp approved template names (per event)
MSG91_WA_TEMPLATE_ANNOUNCEMENT=
MSG91_WA_TEMPLATE_FEE_DUE=
MSG91_WA_TEMPLATE_FEE_RECEIVED=
MSG91_WA_TEMPLATE_ATTENDANCE_ABSENT=

# ─── Payments — Razorpay ────────────────────────────────────────────────────────
# Used by Premium LMS (schools) and Home Schooling subscriptions. Throws 503 if unset.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─── Home Schooling (B2C) ───────────────────────────────────────────────────────
# Separate frontend (apps/homeschool); shares this API + DB.
WEB_URL_HOMESCHOOL=http://localhost:3001
# Family subscription: price per period (INR) and access window (months).
HS_SUBSCRIPTION_PRICE=999
HS_SUBSCRIPTION_MONTHS=12

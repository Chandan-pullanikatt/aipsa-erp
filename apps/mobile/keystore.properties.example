# Release signing for the Android app.
#
# Copy this file to  apps/mobile/android/keystore.properties  and fill in your
# real values. NEVER commit the filled-in file or the .jks keystore — both are
# gitignored (the whole android/ folder is). Store the keystore + these values
# in AIPSA's secret manager; if you lose them you can never update the app.
#
# `storeFile` should point at a keystore kept OUTSIDE the repo so a fresh
# `npx cap add android` can't wipe it. Use an absolute path.

storeFile=C:/Users/you/secrets/aipsa-upload.jks
storePassword=CHANGE_ME
keyAlias=aipsa-upload
keyPassword=CHANGE_ME

# ─────────────────────────────────────────────────────────────────────────────
# Project-level environment for the Dockerized ERP stack.
#
# Copy this file to `.env` (same folder as docker-compose.yml) and fill it in:
#     cp .env.example .env
# `docker compose up` reads this ONE file for the whole project — both for
# ${VAR} interpolation in docker-compose.yml and for the api container's env.
# The web container needs nothing here (it only talks to the internal api).
#
# `.env` is gitignored — never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──
# The compose file builds DATABASE_URL/DIRECT_URL from this password and points
# them at the internal `postgres` service. You only set the password here.
POSTGRES_PASSWORD=change_me_to_a_strong_password

# ── Auth ──
JWT_SECRET=change_this_to_a_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=7d
# Seeds/updates the super admin (admin@aipsa.org) on boot.
SUPER_ADMIN_PASSWORD=change_me

# Public URL of the ERP web app (used in emails, links, CORS).
WEB_URL=https://erp.yourdomain.com

# Rate limiting: leave 'true' for demos (unlimited). Set to 'false' in production.
DISABLE_RATE_LIMIT=false

# ── Home-Schooling catalog proxy ──
# The ERP super-admin catalog screen proxies to the standalone Home-Schooling
# service. Point HS_API_URL at that service's API and set HS_ADMIN_TOKEN to the
# SAME value configured in the Home-Schooling .env. Leave the token blank to
# disable catalog admin (the panel returns a clean 503).
HS_API_URL=http://homeschool-host:3000/api
HS_ADMIN_TOKEN=

# ── Email (SMTP) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@allindiaprivateschools.org

# ── Payments — Razorpay ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Push — Firebase Cloud Messaging (optional) ──
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the full key; keep literal \n sequences (the API converts them).
FIREBASE_PRIVATE_KEY=

# ── SMS + WhatsApp — MSG91 (optional) ──
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_WHATSAPP_NUMBER=
MSG91_WA_LANG=en
MSG91_TEMPLATE_ANNOUNCEMENT=
MSG91_TEMPLATE_FEE_DUE=
MSG91_TEMPLATE_FEE_RECEIVED=
MSG91_TEMPLATE_ATTENDANCE_ABSENT=
MSG91_WA_TEMPLATE_ANNOUNCEMENT=
MSG91_WA_TEMPLATE_FEE_DUE=
MSG91_WA_TEMPLATE_FEE_RECEIVED=
MSG91_WA_TEMPLATE_ATTENDANCE_ABSENT=

# ── File storage (server disk) ──
# Public prefix the browser uses to load a stored file (kept as the proxy path).
LOCAL_UPLOAD_URL_PREFIX=/api/proxy/files
